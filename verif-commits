        self.configure(bg=BG)
        self.entries: list[Entry] = []
        self.row_entries: dict[str, Entry] = {}
        self.scanning = False
        self.busy = False
        self.pending_message = ""
        self._after_id = None
        self.filter_var = tk.StringVar()
        self.filter_var.trace_add("write", lambda *_args: self.populate())
        self.issues_only = tk.BooleanVar(value=False)
        self._build_style()
        self._build_ui()
