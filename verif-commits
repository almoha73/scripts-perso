#!/usr/bin/env python3
"""Moniteur de commits : vérifie, commit et publie les dépôts locaux."""
from __future__ import annotations

import argparse
import curses
import locale
import os
import re
import shutil
import subprocess
import sys
import textwrap
import time
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass, field
from datetime import datetime
from pathlib import Path

DEFAULT_ROOTS = [
    ("~/Applications", False),
    ("~/.local/bin", False),
    ("~/.local/share", True),
]
IGNORED_DIRS = {".git", "__pycache__", "node_modules", ".cache", ".venv", "venv"}
SCRIPTS_REPO = Path(
    os.environ.get("VERIF_SCRIPTS_REPO", "~/Applications/scripts-perso")
).expanduser()
FETCH_TIMEOUT = 25
GIT_ENV = {
    **os.environ,
    "GIT_TERMINAL_PROMPT": "0",
    "GIT_SSH_COMMAND": "ssh -o BatchMode=yes -o ConnectTimeout=10",
    "LC_ALL": "C.UTF-8",
}

OK, WARN, ERR, INFO, DIM = 1, 2, 3, 4, 5
PAIRS: dict[str, int] = {}


@dataclass
class Entry:
    path: Path
    name: str
    is_repo: bool = False
    branch: str = ""
    upstream: str = ""
    remote_url: str = ""
    ahead: int = 0
    behind: int = 0
    dirty: list[str] = field(default_factory=list)
    last_hash: str = ""
    last_date: str = ""
    last_author: str = ""
    last_subject: str = ""
    fetch_ok: bool = True
    fetch_error: str = ""

    @property
    def state(self) -> str:
        if not self.is_repo:
            return "hors git"
        if not self.fetch_ok:
            return "erreur fetch"
        if not self.upstream:
            return "sans remote"
        if self.ahead and self.behind:
            return f"divergent {self.ahead}↑ {self.behind}↓"
        if self.behind:
            return f"{self.behind} en retard"
        if self.ahead:
            return f"{self.ahead} en avance"
        return "à jour"

    @property
    def severity(self) -> int:
        if not self.is_repo:
            return 6
        if not self.fetch_ok:
            return 0
        if self.behind or (self.ahead and self.behind):
            return 1
        if self.ahead:
            return 2
        if self.upstream:
            return 3
        return 4

    @property
    def color(self) -> int:
        if not self.is_repo:
            return DIM
        if not self.fetch_ok or self.behind:
            return ERR
        if self.ahead or self.dirty or not self.upstream:
            return WARN
        return OK


def run(args: list[str], cwd: Path, timeout: int = 10) -> tuple[bool, str]:
    try:
        p = subprocess.run(
            args,
            cwd=cwd,
            env=GIT_ENV,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
        )
        out, err = p.stdout.strip(), p.stderr.strip()
        return p.returncode == 0, out if p.returncode == 0 else (err or out)
    except subprocess.TimeoutExpired:
        return False, "timeout"
    except OSError as exc:
        return False, str(exc)


def scan_entry(path: Path) -> Entry:
    entry = Entry(path=path, name=path.name)
    if not (path / ".git").exists():
        return entry

    entry.is_repo = True
    ok, branch = run(["git", "rev-parse", "--abbrev-ref", "HEAD"], path)
    entry.branch = branch if ok else "?"
    ok, url = run(["git", "remote", "get-url", "origin"], path)
    if ok:
        entry.remote_url = url

    ok_fetch, fetch_out = run(
        ["git", "fetch", "--quiet", "--prune"], path, timeout=FETCH_TIMEOUT
    )
    if not ok_fetch:
        entry.fetch_ok = False
        entry.fetch_error = fetch_out or "échec du fetch"

    ok, upstream = run(
        ["git", "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}"], path
    )
    if ok:
        entry.upstream = upstream
        ok, counts = run(
            ["git", "rev-list", "--left-right", "--count", "HEAD...@{u}"], path
        )
        if ok and counts:
            parts = counts.split()
            if len(parts) == 2:
                entry.ahead, entry.behind = int(parts[0]), int(parts[1])

    ok, status = run(["git", "status", "--porcelain"], path)
    if ok and status:
        entry.dirty = status.splitlines()

    ok, last = run(
        [
            "git",
            "log",
            "-1",
            "--date=format:%d/%m %H:%M",
            "--format=%h%x00%cd%x00%an%x00%s",
        ],
        path,
    )
    if ok and last:
        parts = last.split("\0")
        if len(parts) >= 4:
            entry.last_hash, entry.last_date, entry.last_author, entry.last_subject = (
                parts[0],
                parts[1],
                parts[2],
                "\0".join(parts[3:]),
            )
    return entry


def find_repos(root: Path, max_depth: int = 4) -> list[Path]:
    found: list[Path] = []
    base_depth = len(root.parts)
    for current, dirs, _files in os.walk(root):
        path = Path(current)
        if (path / ".git").exists():
            found.append(path)
            dirs[:] = []
            continue
        if len(path.parts) - base_depth >= max_depth:
            dirs[:] = []
            continue
        dirs[:] = sorted(
            d for d in dirs if d not in IGNORED_DIRS and not d.startswith(".")
        )
    return found


def looks_like_project(path: Path) -> bool:
    markers = (
        "*.py",
        "package.json",
        "Cargo.toml",
        "go.mod",
        "build.gradle",
        "pom.xml",
        "pyproject.toml",
        "setup.py",
        "*.csproj",
    )
    return any(any(path.glob(marker)) for marker in markers)


def discover(roots: list[tuple[Path, bool]]) -> list[Entry]:
    targets: list[Path] = []
    for root, repos_only in roots:
        root = root.expanduser()
        if not root.is_dir():
            continue
        if repos_only:
            repos = find_repos(root)
            targets.extend(repos)
            for child in sorted(root.iterdir(), key=lambda p: p.name.lower()):
                if (
                    child in repos
                    or child.is_symlink()
                    or not child.is_dir()
                    or child.name.startswith(".")
                ):
                    continue
                if looks_like_project(child):
                    targets.append(child)
            continue
        try:
            for child in sorted(root.iterdir(), key=lambda p: p.name.lower()):
                if child.name.startswith(".") or child.is_symlink():
                    continue
                if child.is_dir() or child.is_file():
                    targets.append(child)
        except PermissionError:
            continue
    with ThreadPoolExecutor(max_workers=8) as pool:
        entries = list(pool.map(scan_entry, targets))
    entries.sort(key=lambda e: (e.severity, e.name.lower()))
    return entries


def fmt_commit(entry: Entry, full: bool = True) -> str:
    if not entry.is_repo or not entry.last_hash:
        return "-"
    if full and entry.last_date:
        return f"{entry.last_hash} {entry.last_date}"
    return entry.last_hash


def short(text: str, width: int) -> str:
    if width <= 0:
        return ""
    return text if len(text) <= width else text[: max(0, width - 1)] + "…"


def problems(entries: list[Entry]) -> list[Entry]:
    return [
        e
        for e in entries
        if e.is_repo and (not e.fetch_ok or e.behind or not e.upstream)
    ]


def visible_entries(entries: list[Entry], issues_only: bool) -> list[Entry]:
    if issues_only:
        return [
            e
            for e in entries
            if e.is_repo
            and (e.behind or not e.fetch_ok or not e.upstream or e.ahead or e.dirty)
        ]
    return [e for e in entries if e.is_repo] + [e for e in entries if not e.is_repo]


def state_text(entry: Entry) -> str:
    if not entry.is_repo:
        return "○ hors git"
    if not entry.fetch_ok:
        return "✕ erreur fetch"
    if not entry.upstream:
        return "○ sans remote"
    if entry.ahead and entry.behind:
        return f"◆ {entry.ahead}↑ {entry.behind}↓"
    if entry.behind:
        return f"↓ {entry.behind} en retard"
    if entry.ahead:
        return f"↑ {entry.ahead} en avance"
    return "✓ à jour"


def cp(name: str) -> int:
    return curses.color_pair(PAIRS[name])


def setup_colors() -> None:
    if not curses.has_colors():
        for name in (
            "bg", "muted", "accent", "ok", "warn", "err", "border",
            "card", "card_muted", "card_accent", "card_ok", "card_warn",
            "card_err", "sel", "bar", "bar_key",
        ):
            PAIRS[name] = 0
        return
    curses.start_color()
    try:
        curses.use_default_colors()
        default = -1
    except curses.error:
        default = curses.COLOR_BLACK

    if curses.COLORS >= 256:
        bg, card, card2, text = 234, 235, 237, 255
        muted, accent, green, orange, red = 244, 81, 79, 214, 203
    else:
        bg = card = card2 = default
        text = muted = curses.COLOR_WHITE
        accent = curses.COLOR_CYAN
        green = curses.COLOR_GREEN
        orange = curses.COLOR_YELLOW
        red = curses.COLOR_RED

    specs = {
        "bg": (text, bg),
        "muted": (muted, bg),
        "accent": (accent, bg),
        "ok": (green, bg),
        "warn": (orange, bg),
        "err": (red, bg),
        "border": (card2, bg),
        "card": (text, card),
        "card_muted": (muted, card),
        "card_accent": (accent, card),
        "card_ok": (green, card),
        "card_warn": (orange, card),
        "card_err": (red, card),
        "sel": (bg, accent),
        "bar": (muted, card2),
        "bar_key": (text, card2),
    }
    for index, (name, (fg, bkg)) in enumerate(specs.items(), start=1):
        try:
            curses.init_pair(index, fg, bkg)
            PAIRS[name] = index
        except curses.error:
            PAIRS[name] = 0


def put(scr, y: int, x: int, text: str, attr: int, width: int | None = None) -> None:
    h, w = scr.getmaxyx()
    if y < 0 or y >= h or x < 0 or x >= w or not text:
        return
    limit = max(0, w - x - 1)
    if width is not None:
        limit = min(limit, width)
    try:
        scr.addnstr(y, x, text, limit, attr)
    except curses.error:
        pass


def fill(scr, y: int, x1: int, x2: int, pair: str, char: str = " ") -> None:
    if x2 < x1:
        return
    put(scr, y, x1, char * (x2 - x1 + 1), cp(pair), x2 - x1 + 1)


def draw_box(scr, top: int, left: int, bottom: int, right: int) -> None:
    if bottom <= top or right <= left:
        return
    attr = cp("border")
    try:
        scr.attron(attr)
        for x in range(left + 1, right):
            scr.addch(top, x, curses.ACS_HLINE)
            scr.addch(bottom, x, curses.ACS_HLINE)
        for y in range(top + 1, bottom):
            scr.addch(y, left, curses.ACS_VLINE)
            scr.addch(y, right, curses.ACS_VLINE)
        scr.addch(top, left, curses.ACS_ULCORNER)
        scr.addch(top, right, curses.ACS_URCORNER)
        scr.addch(bottom, left, curses.ACS_LLCORNER)
        scr.addch(bottom, right, curses.ACS_LRCORNER)
        scr.attroff(attr)
    except curses.error:
        pass


def show_progress(stdscr, text: str) -> None:
    h, w = stdscr.getmaxyx()
    stdscr.erase()
    put(stdscr, h // 2, max(0, (w - len(text)) // 2), text, cp("accent") | curses.A_BOLD)
    stdscr.refresh()


def dialog(stdscr, title: str, lines: list[str], options: list[tuple[str, str]],
           default: str | None = None) -> str | None:
    h, w = stdscr.getmaxyx()
    hint = "  ".join(f"[{key.upper()}] {label}" for key, label in options)
    width = max([len(title) + 8, len(hint) + 6] + [len(line) + 8 for line in lines])
    width = min(max(width, 38), w - 4)
    height = min(len(lines) + 5, h - 2)
    y0 = max(0, (h - height) // 2)
    x0 = max(0, (w - width) // 2)
    win = curses.newwin(height, width, y0, x0)
    win.keypad(True)
    win.bkgd(" ", cp("card"))
    win.erase()
    win.attron(cp("border"))
    win.box()
    win.attroff(cp("border"))
    win.addnstr(0, 2, short(f" {title} ", width - 4), width - 4,
                cp("card_accent") | curses.A_BOLD)
    for i, line in enumerate(lines):
        win.addnstr(1 + i, 3, short(line, width - 7), width - 7, cp("card"))
    win.addnstr(height - 2, 3, short(hint, width - 7), width - 7, cp("card_accent"))
    win.refresh()
    while True:
        try:
            key = win.getch()
        except KeyboardInterrupt:
            return None
        if key == curses.KEY_RESIZE:
            continue
        if key in (10, 13, curses.KEY_ENTER):
            return default
        if key == 27:
            return None
        if 0 <= key < 256:
            char = chr(key).lower()
            if any(char == option[0].lower() for option in options):
                return char


def input_dialog(stdscr, title: str, prompt: str, default: str = "") -> str | None:
    h, w = stdscr.getmaxyx()
    width = min(max(52, len(prompt) + 10, len(default) + 10), w - 4)
    height = 5
    y0 = max(0, (h - height) // 2)
    x0 = max(0, (w - width) // 2)
    win = curses.newwin(height, width, y0, x0)
    win.keypad(True)
    text = default
    curses.curs_set(1)
    result = None
    try:
        while True:
            win.bkgd(" ", cp("card"))
            win.erase()
            win.attron(cp("border"))
            win.box()
            win.attroff(cp("border"))
            win.addnstr(0, 2, short(f" {title} ", width - 4), width - 4,
                        cp("card_accent") | curses.A_BOLD)
            win.addnstr(1, 3, short(prompt, width - 6), width - 6, cp("card_muted"))
            field_width = max(4, width - 8)
            shown = text[-field_width:] if len(text) > field_width else text
            win.addnstr(2, 3, "› " + shown, field_width, cp("card"))
            win.addnstr(height - 2, 3, "[Entrée] valider   [Échap] annuler",
                        width - 6, cp("card_muted"))
            try:
                win.move(2, 5 + len(shown))
            except curses.error:
                pass
            win.refresh()
            try:
                key = win.get_wch()
            except curses.error:
                continue
            if key == "\x1b":
                break
            if key in ("\n", "\r", curses.KEY_ENTER):
                result = text.strip()
                break
            if key in (curses.KEY_BACKSPACE, "\b", "\x7f", "\x08"):
                text = text[:-1]
                continue
            if isinstance(key, str) and key.isprintable():
                text += key
    except KeyboardInterrupt:
        result = None
    finally:
        curses.curs_set(0)
    return result


def git_identity(cwd: Path) -> tuple[str, str]:
    _, name = run(["git", "config", "--global", "user.name"], cwd)
    _, email = run(["git", "config", "--global", "user.email"], cwd)
    if not name:
        ok, login = run(["gh", "api", "user", "--jq", ".login"], cwd, timeout=15)
        name = login if ok and login else os.environ.get("USER", "utilisateur")
    if not email:
        ok, mail = run(["gh", "api", "user", "--jq", ".email"], cwd, timeout=15)
        if ok and mail and mail != "null":
            email = mail
        else:
            email = f"{name}@users.noreply.github.com"
    return name, email


def init_and_commit(path: Path) -> tuple[bool, str]:
    ok, _ = run(["git", "init", "-b", "main"], path, timeout=20)
    if not ok:
        ok, _ = run(["git", "init"], path, timeout=20)
        if not ok:
            return False, "impossible d'initialiser le dépôt"
        run(["git", "branch", "-M", "main"], path)
    name, email = git_identity(path)
    run(["git", "config", "user.name", name], path)
    run(["git", "config", "user.email", email], path)
    ok, _ = run(["git", "add", "-A"], path, timeout=60)
    if not ok:
        return False, "échec de l'ajout des fichiers"
    ok, out = run(
        ["git", "commit", "-m", "chore: initialisation du dépôt"], path, timeout=60
    )
    if not ok:
        return False, out or "aucun fichier à committer"
    return True, "Dépôt git créé et premier commit effectué."


def publish_repo(path: Path, name: str, private: bool) -> tuple[bool, str]:
    ok, owner = run(["gh", "api", "user", "--jq", ".login"], path, timeout=15)
    if not ok or not owner:
        return False, "gh n'est pas authentifié"
    slug = re.sub(r"[^A-Za-z0-9._-]+", "-", name).strip("-.") or "projet"
    visibility = "--private" if private else "--public"
    ok, out = run(
        [
            "gh", "repo", "create", f"{owner}/{slug}", visibility,
            "--source", str(path), "--remote", "origin", "--push",
        ],
        path,
        timeout=120,
    )
    if ok:
        return True, f"Publié sur https://github.com/{owner}/{slug}"
    return False, out or "échec de la création sur GitHub"


def is_moveable_script(path: Path) -> bool:
    if path.is_symlink() or not path.is_file():
        return False
    try:
        with path.open("rb") as handle:
            return handle.read(2) == b"#!"
    except OSError:
        return False


def dirty_name(line: str) -> str:
    return line[3:] if len(line) > 3 else line


def commit_flow(stdscr, entry: Entry) -> str:
    if not entry.dirty:
        return "Aucune modification à commiter."
    files = ", ".join(dirty_name(line) for line in entry.dirty)
    more = f" (+{len(entry.dirty)} fichiers)" if len(entry.dirty) > 1 else ""
    wrapped = textwrap.wrap(files, 54) or [""]
    default_message = f"chore: mise à jour {datetime.now():%d/%m/%Y %H:%M}"
    lines = [
        f"{len(entry.dirty)} fichier(s) modifié(s)",
        *wrapped[:3],
        "",
        f"Message : {default_message}",
    ]
    choice = dialog(
        stdscr,
        f"Commiter {entry.name} ?",
        lines,
        [("o", "Commiter et pousser"), ("m", "Changer le message"), ("n", "Annuler")],
        default="n",
    )
    if choice is None or choice == "n":
        return "Commit annulé."
    message = default_message
    if choice == "m":
        edited = input_dialog(
            stdscr, "Message de commit", "Message (vide = défaut) :", ""
        )
        if edited is None:
            return "Commit annulé."
        message = edited or message
    show_progress(stdscr, f"Commit de {entry.name}…")
    ok, out = run(["git", "add", "-A"], entry.path, timeout=60)
    if not ok:
        return f"Échec de git add : {out}"
    ok, out = run(["git", "commit", "-m", message], entry.path, timeout=60)
    if not ok:
        return f"Échec du commit : {out}"
    if entry.upstream:
        show_progress(stdscr, "Envoi vers le remote…")
        ok, out = run(["git", "push"], entry.path, timeout=120)
        if not ok:
            return f"Commité, mais push échoué : {out}"
        return f"{entry.name} commité et poussé."
    if entry.remote_url:
        show_progress(stdscr, "Envoi vers le remote…")
        ok, out = run(
            ["git", "push", "-u", "origin", entry.branch], entry.path, timeout=120
        )
        if not ok:
            return f"Commité, mais push échoué : {out}"
        return f"{entry.name} commité et poussé."
    return f"{entry.name} commité localement (aucun remote configuré)."


def move_script_flow(stdscr, entry: Entry) -> str:
    source = entry.path
    destination = SCRIPTS_REPO / source.name
    if not SCRIPTS_REPO.is_dir():
        return f"Dépôt introuvable : {SCRIPTS_REPO}"
    if destination.exists():
        return f"Un fichier {source.name} existe déjà dans scripts-perso."
    choice = dialog(
        stdscr,
        "Déplacer dans scripts-perso ?",
        [
            str(source),
            f"Vers {destination}",
            "Un lien symbolique sera laissé à l'emplacement actuel.",
        ],
        [("o", "Oui"), ("n", "Non")],
        default="n",
    )
    if choice != "o":
        return "Déplacement annulé."
    show_progress(stdscr, f"Déplacement de {source.name}…")
    try:
        shutil.move(str(source), str(destination))
        os.symlink(destination, source)
    except OSError as exc:
        return f"Échec du déplacement : {exc}"
    ok, out = run(["git", "add", "--", str(destination)], SCRIPTS_REPO, timeout=30)
    if not ok:
        return f"Fichier déplacé, mais échec de git add : {out}"
    ok, out = run(
        ["git", "commit", "-m", f"feat: ajout de {source.name}"],
        SCRIPTS_REPO,
        timeout=30,
    )
    if not ok:
        return f"Fichier déplacé, mais échec du commit : {out}"
    show_progress(stdscr, "Envoi vers GitHub…")
    ok, out = run(["git", "push", "origin", "HEAD"], SCRIPTS_REPO, timeout=120)
    if not ok:
        return f"Déplacé et commité, mais push échoué : {out}"
    return f"{source.name} déplacé dans scripts-perso, commité et poussé."


def create_flow(stdscr, entry: Entry) -> str:
    if not entry.path.is_dir():
        return "Seuls les dossiers peuvent être initialisés."
    choice = dialog(
        stdscr,
        "Créer un dépôt git ?",
        [str(entry.path), "Un premier commit sera créé."],
        [("o", "Oui"), ("n", "Non")],
        default="n",
    )
    if choice != "o":
        return "Création annulée."
    show_progress(stdscr, f"Initialisation de {entry.name}…")
    ok, message = init_and_commit(entry.path)
    if not ok:
        return f"Échec : {message}"
    choice = dialog(
        stdscr,
        "Publier sur GitHub ?",
        [message, "Choisir la visibilité du dépôt distant."],
        [("o", "Public"), ("p", "Privé"), ("n", "Local seulement")],
        default="n",
    )
    if choice in ("o", "p"):
        show_progress(stdscr, "Création du dépôt GitHub…")
        ok, published = publish_repo(entry.path, entry.name, choice == "p")
        if not ok:
            return f"Dépôt local créé, publication échouée : {published}"
        return published
    return message


def print_report(entries: list[Entry]) -> int:
    now = datetime.now().strftime("%d/%m/%Y %H:%M:%S")
    print(f"Vérification des commits — {now}\n")
    for e in entries:
        if not e.is_repo:
            print(f"  {e.name:<24} hors git")
            continue
        extra = f" (+{len(e.dirty)} modif.)" if e.dirty else ""
        print(
            f"  {e.name:<24} {e.branch:<12} {e.state:<20}{extra}"
            f"  {fmt_commit(e)}  {short(e.last_subject, 50)}"
        )
    bad = problems(entries)
    print()
    if bad:
        print(f"{len(bad)} dépôt(s) à vérifier : " + ", ".join(e.name for e in bad))
        return 1
    print("Tous les dépôts suivis sont à jour.")
    return 0


def build_columns(width: int) -> list[tuple[str, int]]:
    if width >= 90:
        cols = [("DÉPÔT", 22), ("BRANCHE", 12), ("ÉTAT", 18),
                ("MODIFS", 7), ("COMMIT", 20)]
    elif width >= 78:
        cols = [("DÉPÔT", 20), ("BRANCHE", 10), ("ÉTAT", 18),
                ("MODIFS", 7), ("COMMIT", 8)]
    elif width >= 62:
        cols = [("DÉPÔT", 18), ("ÉTAT", 17), ("MODIFS", 6), ("COMMIT", 8)]
    else:
        cols = [("DÉPÔT", 14), ("ÉTAT", 16), ("MODIFS", 5)]
    used = sum(w for _label, w in cols)
    cols.append(("MESSAGE", max(6, width - used)))
    return cols


def row_values(entry: Entry, full_commit: bool = False) -> dict[str, str]:
    return {
        "DÉPÔT": entry.name,
        "BRANCHE": entry.branch or "-",
        "ÉTAT": state_text(entry),
        "MODIFS": str(len(entry.dirty)) if entry.is_repo else "-",
        "COMMIT": fmt_commit(entry, full=full_commit),
        "MESSAGE": entry.last_subject or "",
    }


def draw(stdscr, entries, selected, offset, last_scan, duration, issues_only, message):
    h, w = stdscr.getmaxyx()
    stdscr.erase()
    if h < 10 or w < 50:
        put(stdscr, 0, 0, "Terminal trop petit (min. 50x10)", cp("err"))
        stdscr.refresh()
        return selected, offset

    repos = [e for e in entries if e.is_repo]
    visible = visible_entries(entries, issues_only)
    if visible:
        selected = max(0, min(selected, len(visible) - 1))
    else:
        selected = 0

    bad = problems(entries)
    dirty_count = sum(1 for e in repos if e.dirty)

    put(stdscr, 0, 1, "Moniteur de commits", cp("bg") | curses.A_BOLD)
    if bad:
        badge = f"● {len(bad)} à vérifier"
        badge_pair = "err"
    elif dirty_count:
        badge = f"● {dirty_count} modif. locale(s)"
        badge_pair = "warn"
    else:
        badge = "● tout est synchronisé"
        badge_pair = "ok"
    put(stdscr, 0, max(1, w - len(badge) - 2), badge, cp(badge_pair) | curses.A_BOLD)

    subtitle = (
        f"Dépôts et scripts locaux · scan {last_scan} · "
        f"{len(repos)} dépôts · {duration:.1f}s"
    )
    put(stdscr, 1, 1, short(subtitle, w - 2), cp("muted"))

    card_top, card_left, card_right = 2, 1, w - 2
    detail_h = 7 if h >= 18 else 0
    footer_y = h - 1
    if detail_h:
        detail_bottom = h - 2
        detail_top = detail_bottom - detail_h + 1
        card_bottom = detail_top - 1
    else:
        detail_top = detail_bottom = None
        card_bottom = footer_y - 1

    draw_box(stdscr, card_top, card_left, card_bottom, card_right)
    inner_left = card_left + 2
    inner_right = card_right - 2
    inner_width = max(1, inner_right - inner_left + 1)

    cols = build_columns(inner_width)
    header_y = card_top + 1
    x = inner_left
    for label, width in cols:
        put(stdscr, header_y, x, short(label, width - 1), cp("card_muted") | curses.A_BOLD)
        x += width
    fill(stdscr, header_y + 1, inner_left, inner_right, "card_muted", "─")

    rows_top = header_y + 2
    rows = max(1, card_bottom - rows_top)
    if selected < offset:
        offset = selected
    elif selected >= offset + rows:
        offset = selected - rows + 1

    if visible:
        for i, entry in enumerate(visible[offset : offset + rows]):
            y = rows_top + i
            is_selected = (offset + i) == selected
            if is_selected:
                fill(stdscr, y, inner_left, inner_right, "sel")
                base = "sel"
                colors = {
                    "name": "sel", "muted": "sel", "state": "sel",
                    "warn": "sel", "ok": "sel", "err": "sel",
                }
            else:
                fill(stdscr, y, inner_left, inner_right, "card")
                base = "card"
                colors = {
                    "name": "card", "muted": "card_muted", "state": "card",
                    "warn": "card_warn", "ok": "card_ok", "err": "card_err",
                }
            pair_for = {
                OK: colors["ok"], WARN: colors["warn"],
                ERR: colors["err"], INFO: colors["name"], DIM: colors["muted"],
            }[entry.color]
            full_commit = next(
                (width for label, width in cols if label == "COMMIT"), 8
            ) >= 19
            values = row_values(entry, full_commit)
            x = inner_left
            for label, width in cols:
                value = values[label]
                if is_selected:
                    pair = "sel"
                elif label == "DÉPÔT":
                    pair = "card"
                elif label == "ÉTAT":
                    pair = pair_for
                elif label == "MODIFS":
                    pair = "card_warn" if entry.dirty else "card_muted"
                elif label == "BRANCHE":
                    pair = "card_muted"
                elif label == "COMMIT":
                    pair = "card_muted"
                else:
                    pair = "card_muted"
                put(stdscr, y, x, short(value, width - 1), cp(pair), width - 1)
                x += width
    else:
        put(stdscr, rows_top + 1, inner_left + 2, "Aucun dépôt à afficher.",
            cp("card_muted"))

    if detail_h and visible:
        entry = visible[selected]
        draw_box(stdscr, detail_top, card_left, detail_bottom, card_right)
        for line_y in range(detail_top + 1, detail_bottom):
            fill(stdscr, line_y, inner_left, inner_right, "card")
        y = detail_top + 1
        put(stdscr, y, inner_left, "▸ ", cp("card_accent") | curses.A_BOLD)
        put(stdscr, y, inner_left + 2, short(str(entry.path), inner_width - 2),
            cp("card_accent"))
        y += 1
        if entry.is_repo:
            line = f"Remote  {entry.remote_url or '-'}"
            if entry.upstream:
                line += f"   ·   Suivi  {entry.upstream}"
            line += f"   ·   Écart  {entry.ahead}↑ {entry.behind}↓"
            put(stdscr, y, inner_left, short(line, inner_width), cp("card_muted"))
            y += 1
            commit = "-"
            if entry.last_hash:
                commit = (
                    f"{entry.last_hash}  ·  {entry.last_date}  ·  "
                    f"{entry.last_author} — {entry.last_subject}"
                )
            put(stdscr, y, inner_left, short(commit, inner_width), cp("card"))
            y += 1
            if entry.dirty:
                names = ", ".join(dirty_name(line) for line in entry.dirty[:4])
                more = " …" if len(entry.dirty) > 4 else ""
                put(stdscr, y, inner_left,
                    short(f"Modifs   {len(entry.dirty)} fichier(s) : {names}{more}",
                          inner_width),
                    cp("card_warn"))
            elif not entry.fetch_ok:
                put(stdscr, y, inner_left, short(f"Erreur   {entry.fetch_error}",
                                                inner_width), cp("card_err"))
            else:
                put(stdscr, y, inner_left, "Modifs   aucune", cp("card_muted"))
        else:
            if entry.path.is_dir():
                hint = "Pas un dépôt git — c pour l'initialiser."
            elif is_moveable_script(entry.path):
                hint = "Script hors git — c pour le déplacer dans scripts-perso."
            else:
                hint = "Fichier hors git — déplacement non proposé."
            put(stdscr, y, inner_left, short(hint, inner_width), cp("card_muted"))
        put(stdscr, detail_bottom - 1, inner_left, short(message, inner_width),
            cp("card_muted"))

    fill(stdscr, footer_y, 0, w - 2, "bar")
    hints = [
        ("↑↓", "naviguer"), ("r", "rafraîchir"), ("f", "filtre"),
        ("c", "commiter / créer"), ("q", "quitter"),
    ]
    x = 1
    for key, label in hints:
        if x >= w - 2:
            break
        put(stdscr, footer_y, x, key, cp("bar_key") | curses.A_BOLD)
        x += len(key) + 1
        put(stdscr, footer_y, x, label, cp("bar"))
        x += len(label) + 3
    if issues_only and w > 60:
        badge = " filtre problèmes "
        put(stdscr, footer_y, w - len(badge) - 2, badge,
            cp("bar_key") | curses.A_BOLD)

    stdscr.refresh()
    return selected, offset


def run_tui(stdscr, roots: list[tuple[Path, bool]]):
    curses.curs_set(0)
    setup_colors()
    try:
        stdscr.bkgd(" ", cp("bg"))
    except curses.error:
        pass
    stdscr.keypad(True)

    entries: list[Entry] = []
    selected = 0
    offset = 0
    issues_only = False
    message = "Scan en cours…"
    last_scan = "-"
    duration = 0.0

    def refresh():
        nonlocal entries, last_scan, duration, message
        message = "Scan en cours…"
        draw(stdscr, entries, selected, offset, last_scan, duration, issues_only, message)
        start = time.monotonic()
        entries = discover(roots)
        duration = time.monotonic() - start
        last_scan = datetime.now().strftime("%H:%M:%S")
        message = f"{len(problems(entries))} dépôt(s) à vérifier"

    refresh()
    while True:
        selected, offset = draw(
            stdscr, entries, selected, offset, last_scan, duration, issues_only, message
        )
        try:
            key = stdscr.getch()
        except KeyboardInterrupt:
            break
        if key in (ord("q"), ord("Q"), 27):
            break
        if key in (curses.KEY_UP, ord("k")):
            selected = max(0, selected - 1)
        elif key in (curses.KEY_DOWN, ord("j")):
            selected += 1
        elif key in (curses.KEY_HOME, ord("g")):
            selected = 0
        elif key in (curses.KEY_END, ord("G")):
            selected = 10**6
        elif key in (ord("r"), ord("R"), curses.KEY_RESIZE):
            refresh()
        elif key in (ord("f"), ord("F")):
            issues_only = not issues_only
            selected = 0
            offset = 0
        elif key in (ord("c"), ord("C")):
            visible = visible_entries(entries, issues_only)
            if not visible:
                message = "Aucune entrée sélectionnée."
                continue
            entry = visible[min(selected, len(visible) - 1)]
            if entry.is_repo:
                if not entry.dirty:
                    message = f"{entry.name} n'a aucune modification à commiter."
                    continue
                result = commit_flow(stdscr, entry)
            elif entry.path.is_dir():
                result = create_flow(stdscr, entry)
            elif is_moveable_script(entry.path):
                result = move_script_flow(stdscr, entry)
            else:
                message = "Ce fichier n'est pas un script déplaçable."
                continue
            refresh()
            message = f"{result} · {len(problems(entries))} dépôt(s) à vérifier"


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Vérifie que les dépôts git sont à jour avec leur remote."
    )
    parser.add_argument(
        "--root",
        action="append",
        dest="roots",
        help="dossier à scanner en plus des dossiers par défaut",
    )
    parser.add_argument(
        "--once", action="store_true", help="rapport texte non interactif"
    )
    args = parser.parse_args()
    roots = [(Path(p), repos_only) for p, repos_only in DEFAULT_ROOTS]
    roots += [(Path(p), False) for p in (args.roots or [])]

    if args.once or not sys.stdout.isatty():
        locale.setlocale(locale.LC_ALL, "")
        return print_report(discover(roots))

    locale.setlocale(locale.LC_ALL, "")
    curses.wrapper(run_tui, roots)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
