        self.tree.tag_configure("odd", background=ROW_ALT)
        self.tree.tag_configure("ok", foreground=GREEN)
        self.tree.tag_configure("warn", foreground=ORANGE)
        self.tree.tag_configure("err", foreground=RED)
        self.tree.tag_configure("muted", foreground=MUTED)
        self.tree.grid(row=0, column=0, sticky="nsew")
        self.tree.bind("<<TreeviewSelect>>", lambda _event: self.update_detail())
        self.tree.bind("<Double-1>", lambda _event: self.primary_action())

        scrollbar = ttk.Scrollbar(
            table_frame, orient="vertical", command=self.tree.yview,
            style="Vertical.TScrollbar",
        )
        scrollbar.grid(row=0, column=1, sticky="ns")
        self.tree.configure(yscrollcommand=scrollbar.set)

        detail = tk.Frame(main_card, bg=CARD)
        detail.grid(row=2, column=0, sticky="ew", padx=16, pady=(10, 0))
        detail.grid_columnconfigure(0, weight=1)
        tk.Frame(detail, bg=CARD2, height=1).grid(row=0, column=0, sticky="ew")
        self.detail_path = tk.Label(
            detail, text="Sélectionne un dépôt", bg=CARD, fg=ACCENT,
            font=(FONT, 9, "bold"), anchor="w",
        )
        self.detail_path.grid(row=1, column=0, sticky="w", pady=(10, 2))
        self.detail_info = tk.Label(
            detail, text="", bg=CARD, fg=MUTED, font=(FONT, 9), anchor="w",
            justify="left", wraplength=1100,
        )
        self.detail_info.grid(row=2, column=0, sticky="w")
        self.detail_commit = tk.Label(
            detail, text="", bg=CARD, fg=TEXT, font=(FONT, 9), anchor="w",
            justify="left", wraplength=1100,
        )
        self.detail_commit.grid(row=3, column=0, sticky="w", pady=(2, 0))
        self.detail_dirty = tk.Label(
            detail, text="", bg=CARD, fg=ORANGE, font=(FONT, 9), anchor="w",
            justify="left", wraplength=1100,
        )
        self.detail_dirty.grid(row=4, column=0, sticky="w", pady=(2, 0))

        footer = tk.Frame(main_card, bg=CARD)
        footer.grid(row=3, column=0, sticky="ew", padx=16, pady=(10, 12))
        footer.grid_columnconfigure(0, weight=1)
        self.status_label = tk.Label(
            footer, text="", bg=CARD, fg=MUTED, font=(FONT, 9), anchor="w",
        )
        self.status_label.grid(row=0, column=0, sticky="w")

        actions = tk.Frame(footer, bg=CARD)
        actions.grid(row=0, column=1, sticky="e")
        self.btn_commit = make_button(
            actions, "Commiter et pousser", self.action_commit, "accent"
        )
        self.btn_create = make_button(
            actions, "Créer le dépôt", self.action_create, "accent"
        )
        self.btn_move = make_button(
            actions, "Déplacer vers scripts-perso", self.action_move, "ghost"
        )

        self._after_id = self.after(300000, self._auto_refresh)

    def _auto_refresh(self):
        if not self.scanning and not self.busy:
            self.refresh()
        self._after_id = self.after(300000, self._auto_refresh)

    def refresh(self):
        if self.scanning or self.busy:
            return
        self.scanning = True
        self.live_label.configure(text="●  SCAN…", fg=MUTED)
        self.refresh_button.state(["disabled"])
        start = time.monotonic()

        def work():
            entries = discover(self.roots)
            duration = time.monotonic() - start

            def apply():
                self.scanning = False
                self.refresh_button.state(["!disabled"])
                self.entries = entries
                self.scan_label.configure(
                    text=f"dernier scan {datetime.now():%H:%M:%S} · {duration:.1f}s"
                )
                if self.pending_message:
                    self.status_label.configure(text=self.pending_message, fg=MUTED)
                    self.pending_message = ""
                else:
                    bad = len(problems(entries))
                    dirty = sum(1 for e in entries if e.is_repo and e.dirty)
                    status = f"{bad} dépôt(s) à vérifier"
                    if dirty:
                        status += f" · {dirty} avec modifs locales"
                    self.status_label.configure(text=status, fg=MUTED)
                self.update_summary()
                self.populate()

            self.after(0, apply)

        threading.Thread(target=work, daemon=True).start()

    def update_summary(self):
        repos = [e for e in self.entries if e.is_repo]
        bad = problems(self.entries)
        dirty = [e for e in repos if e.dirty]
        good = [e for e in repos if e not in bad]
        self.repo_value.configure(text=str(len(repos)))
        self.ok_value.configure(text=str(len(good)))
        self.issue_value.configure(text=str(len(bad)))
        self.dirty_value.configure(text=str(len(dirty)))
        if bad:
            self.live_label.configure(text=f"●  {len(bad)} À VÉRIFIER", fg=RED)
        elif dirty:
            self.live_label.configure(
                text=f"●  {len(dirty)} MODIF. LOCALE(S)", fg=ORANGE
            )
        else:
            self.live_label.configure(text="●  SYNCHRONISÉ", fg=GREEN)

    def filtered_entries(self) -> list[Entry]:
        entries = self.entries
        if self.issues_only.get():
            entries = [
                e for e in entries
                if e.is_repo and (e.behind or not e.fetch_ok or not e.upstream
                                  or e.ahead or e.dirty)
            ]
        text = self.filter_var.get().strip().lower()
        if text:
            entries = [
                e for e in entries
                if text in e.name.lower()
                or text in str(e.path).lower()
                or text in state_text(e).lower()
                or text in e.last_subject.lower()
                or text in e.branch.lower()
            ]
        return entries

    def populate(self):
        selected_path = self.selected_entry().path if self.selected_entry() else None
        self.tree.delete(*self.tree.get_children())
        self.row_entries.clear()
        for index, entry in enumerate(self.filtered_entries()):
            tag = {OK: "ok", WARN: "warn", ERR: "err", DIM: "muted",
                   INFO: "muted"}[entry.color]
            values = (
                entry.name,
                entry.branch or "-",
                state_text(entry),
                str(len(entry.dirty)) if entry.is_repo else "-",
                fmt_commit(entry),
                entry.last_subject or "",
            )
            iid = self.tree.insert(
                "", "end", values=values,
                tags=("even" if index % 2 == 0 else "odd", tag),
            )
            self.row_entries[iid] = entry
        children = self.tree.get_children()
        target = None
        if selected_path:
            for iid, entry in self.row_entries.items():
                if entry.path == selected_path:
                    target = iid
                    break
        if target is None and children:
            target = children[0]
        if target:
            self.tree.selection_set(target)
            self.tree.focus(target)
            self.tree.see(target)
        self.update_detail()

    def selected_entry(self) -> Entry | None:
        selection = self.tree.selection()
        if not selection:
            return None
        return self.row_entries.get(selection[0])

    def update_detail(self):
        entry = self.selected_entry()
        for button in (self.btn_commit, self.btn_create, self.btn_move):
            button.pack_forget()
        if entry is None:
            self.detail_path.configure(text="Sélectionne un dépôt", fg=MUTED)
            self.detail_info.configure(text="")
            self.detail_commit.configure(text="")
            self.detail_dirty.configure(text="")
            return
        self.detail_path.configure(text=str(entry.path), fg=ACCENT)
        if entry.is_repo:
            info = f"Remote  {entry.remote_url or 'aucun'}"
            info += f"   ·   Suivi  {entry.upstream or 'aucun'}"
            info += f"   ·   Écart  {entry.ahead}↑ {entry.behind}↓"
            self.detail_info.configure(text=info)
            if entry.last_hash:
                commit = (
                    f"{entry.last_hash}  ·  {entry.last_date}  ·  "
                    f"{entry.last_author} — {entry.last_subject}"
                )
            else:
                commit = "Aucun commit"
            self.detail_commit.configure(text=commit)
            if entry.dirty:
                names = ", ".join(dirty_name(line) for line in entry.dirty[:5])
                more = " …" if len(entry.dirty) > 5 else ""
                self.detail_dirty.configure(
                    text=f"Modifs  {len(entry.dirty)} fichier(s) : {names}{more}",
                    fg=ORANGE,
                )
                self.btn_commit.pack(side="left", padx=(0, 6))
            elif not entry.fetch_ok:
                self.detail_dirty.configure(
                    text=f"Erreur  {entry.fetch_error}", fg=RED
                )
            else:
                self.detail_dirty.configure(text="Modifs  aucune", fg=MUTED)
        else:
            self.detail_info.configure(text="Aucun suivi de commits pour cette entrée")
            self.detail_commit.configure(text="")
            if entry.path.is_dir():
                self.detail_dirty.configure(
                    text="Pas un dépôt git — tu peux l'initialiser.", fg=MUTED
                )
                self.btn_create.pack(side="left", padx=(0, 6))
            elif is_moveable_script(entry.path):
                self.detail_dirty.configure(
                    text="Script hors git — tu peux le déplacer dans scripts-perso.",
                    fg=MUTED,
                )
                self.btn_move.pack(side="left", padx=(0, 6))
            else:
                self.detail_dirty.configure(
                    text="Fichier hors git — déplacement non proposé.", fg=MUTED
                )

    def primary_action(self):
        entry = self.selected_entry()
        if entry is None:
            return
        if entry.is_repo and entry.dirty:
            self.action_commit()
        elif not entry.is_repo and entry.path.is_dir():
            self.action_create()
        elif is_moveable_script(entry.path):
            self.action_move()

    def set_busy(self, text: str | None):
        self.busy = bool(text)
        if text:
            self.live_label.configure(text=f"●  {text}", fg=MUTED)
            self.refresh_button.state(["disabled"])
        else:
            self.refresh_button.state(["!disabled"])

    def run_async(self, work, done):
        def runner():
            try:
                result = work()
            except Exception as exc:
                result = (False, str(exc))
            self.after(0, lambda: done(result))

        threading.Thread(target=runner, daemon=True).start()

    def ask(self, title, lines, options, width=560):
        win = tk.Toplevel(self)
        win.title(title)
        win.configure(bg=CARD)
        win.transient(self)
        win.resizable(False, False)
        result = {"value": None}

        body = tk.Frame(win, bg=CARD, padx=22, pady=18)
        body.pack(fill="both", expand=True)
        tk.Label(
            body, text=title, bg=CARD, fg=TEXT, font=(FONT, 12, "bold"),
            anchor="w",
        ).pack(anchor="w")
        for line in lines:
            tk.Label(
                body, text=line, bg=CARD, fg=MUTED, font=(FONT, 9),
                anchor="w", justify="left", wraplength=width - 44,
            ).pack(anchor="w", pady=(6, 0))
        buttons = tk.Frame(body, bg=CARD)
        buttons.pack(fill="x", pady=(18, 0))

        def choose(value):
            result["value"] = value
            win.destroy()

        for key, label, kind in reversed(options):
            make_button(
                buttons, label, lambda v=key: choose(v), kind
            ).pack(side="right", padx=(8, 0))

        win.bind("<Escape>", lambda _event: choose(None))
        win.update_idletasks()
        x = self.winfo_rootx() + (self.winfo_width() - win.winfo_width()) // 2
        y = self.winfo_rooty() + (self.winfo_height() - win.winfo_height()) // 2
        win.geometry(f"+{max(0, x)}+{max(0, y)}")
        win.grab_set()
        win.focus_force()
        self.wait_window(win)
        return result["value"]

    def show_message(self, title, lines, error=False):
        self.ask(
            title,
            lines,
            [("ok", "Fermer", "danger" if error else "ghost")],
            width=560,
        )

    def ask_commit(self, entry: Entry) -> str | None:
        win = tk.Toplevel(self)
        win.title(f"Commiter {entry.name}")
        win.configure(bg=CARD)
        win.transient(self)
        win.resizable(False, False)
        result = {"value": None}
        default = f"chore: mise à jour {datetime.now():%d/%m/%Y %H:%M}"

        body = tk.Frame(win, bg=CARD, padx=22, pady=18)
        body.pack(fill="both", expand=True)
        tk.Label(
            body, text=f"Commiter {entry.name}", bg=CARD, fg=TEXT,
            font=(FONT, 12, "bold"), anchor="w",
        ).pack(anchor="w")
        files = ", ".join(dirty_name(line) for line in entry.dirty[:6])
        more = " …" if len(entry.dirty) > 6 else ""
        tk.Label(
            body, text=f"{len(entry.dirty)} fichier(s) : {files}{more}",
            bg=CARD, fg=MUTED, font=(FONT, 9), anchor="w", justify="left",
            wraplength=520,
        ).pack(anchor="w", pady=(6, 0))
        tk.Label(
            body, text="Message de commit", bg=CARD, fg=MUTED, font=(FONT, 9),
            anchor="w",
        ).pack(anchor="w", pady=(14, 4))
        message_var = tk.StringVar(value=default)
        message_entry = ttk.Entry(
            body, textvariable=message_var, style="Dark.TEntry", width=52,
        )
        message_entry.pack(fill="x")
        buttons = tk.Frame(body, bg=CARD)
        buttons.pack(fill="x", pady=(18, 0))

        def commit():
            result["value"] = message_var.get().strip() or default
            win.destroy()

        make_button(buttons, "Commiter et pousser", commit, "accent").pack(
            side="right"
        )
        make_button(buttons, "Annuler", win.destroy, "ghost").pack(
            side="right", padx=(8, 0)
        )
        win.bind("<Escape>", lambda _event: win.destroy())
        message_entry.bind("<Return>", lambda _event: commit())
        message_entry.focus_set()
        message_entry.selection_range(0, "end")
        win.update_idletasks()
        x = self.winfo_rootx() + (self.winfo_width() - win.winfo_width()) // 2
        y = self.winfo_rooty() + (self.winfo_height() - win.winfo_height()) // 2
        win.geometry(f"+{max(0, x)}+{max(0, y)}")
        win.grab_set()
        win.focus_force()
        self.wait_window(win)
        return result["value"]

    def action_commit(self):
        entry = self.selected_entry()
        if entry is None or not entry.is_repo or not entry.dirty:
            return
        message = self.ask_commit(entry)
        if not message:
            return
        self.set_busy(f"COMMIT {entry.name}…")

        def done(result):
            ok, text = result
            self.set_busy(None)
            if not ok:
                self.show_message("Échec du commit", [text], error=True)
            self.pending_message = text
            self.refresh()

        self.run_async(lambda: commit_repo(entry, message), done)

    def action_create(self):
        entry = self.selected_entry()
        if entry is None or entry.is_repo or not entry.path.is_dir():
            return
        choice = self.ask(
            "Créer un dépôt git ?",
            [str(entry.path), "Un premier commit sera créé."],
            [("n", "Annuler", "ghost"), ("o", "Créer", "accent")],
        )
        if choice != "o":
            return
        self.set_busy(f"INIT {entry.name}…")

        def done(result):
            ok, text = result
            self.set_busy(None)
            if not ok:
                self.show_message("Échec de l'initialisation", [text], error=True)
                self.refresh()
                return
            visibility = self.ask(
                "Publier sur GitHub ?",
                [text, "Choisir la visibilité du dépôt distant."],
                [("n", "Local seulement", "ghost"),
                 ("p", "Privé", "ghost"),
                 ("o", "Public", "accent")],
            )
            if visibility in ("o", "p"):
                self.set_busy("PUBLICATION…")

                def published(result2):
                    ok2, text2 = result2
                    self.set_busy(None)
                    if not ok2:
                        self.show_message(
                            "Publication impossible", [text2], error=True
                        )
                    self.pending_message = text2
                    self.refresh()

                self.run_async(
                    lambda: publish_repo(entry.path, entry.name, visibility == "p"),
                    published,
                )
            else:
                self.pending_message = text
                self.refresh()

        self.run_async(lambda: init_and_commit(entry.path), done)

    def action_move(self):
        entry = self.selected_entry()
        if entry is None or entry.is_repo or not is_moveable_script(entry.path):
            return
        choice = self.ask(
            "Déplacer dans scripts-perso ?",
            [
                str(entry.path),
                f"Vers {SCRIPTS_REPO / entry.name}",
                "Un lien symbolique sera laissé à l'emplacement actuel.",
            ],
            [("n", "Annuler", "ghost"), ("o", "Déplacer", "accent")],
        )
        if choice != "o":
            return
        self.set_busy(f"DÉPLACEMENT {entry.name}…")

        def done(result):
            ok, text = result
            self.set_busy(None)
            if not ok:
                self.show_message("Échec du déplacement", [text], error=True)
            self.pending_message = text
            self.refresh()

        self.run_async(lambda: move_script(entry.path), done)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Vérifie que les dépôts git sont à jour avec leur remote."
    )
    parser.add_argument(
        "--root",
        action="append",
        dest="roots",
        help="dossier à scanner en plus des dossiers par défaut",
    )
    parser.add_argument(
        "--once", action="store_true", help="rapport texte non interactif"
    )
    args = parser.parse_args()
    roots = [(Path(p), repos_only) for p, repos_only in DEFAULT_ROOTS]
    roots += [(Path(p), False) for p in (args.roots or [])]

    has_display = bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))
    if args.once or not has_display:
        locale.setlocale(locale.LC_ALL, "")
        return print_report(discover(roots))

    locale.setlocale(locale.LC_ALL, "")
    app = CommitMonitor(roots)
    app.mainloop()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
